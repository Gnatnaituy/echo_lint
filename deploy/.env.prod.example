# =============================================================================
# EchoLint 生产环境变量模板（P2-27/P2-28）
#
# 使用：
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod
#   # 编辑 deploy/.env.prod，把全部 CHANGE_ME_* 替换为强随机值
#
# 本文件同时承担两个角色：
#   1) compose 插值来源：docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml ...
#   2) backend 容器的 env_file（compose 已挂载 path: .env.prod）——即 APP_*/AI 变量也从这里注入。
# 完整的应用变量清单/默认值见仓库根 .env.example；把需要的条目（通知/抽样/双声道/集成/RAG 等）
# 直接追加到本文件即可。
#
# 安全：deploy/.env.prod 已被 deploy/.gitignore 忽略，切勿提交；不要复用开发环境 .env。
# =============================================================================

# ---- 必填：数据库 ----------------------------------------------------------
# bootstrap 超级用户 audit 的口令（初始化/备份/运维用），必须覆盖为空以外的强口令。
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_SUPERUSER_PASSWORD
# 应用角色 echolint_app 的口令（backend 使用；由 02-app-password.sh 在首次初始化时写入）。
# 已有数据卷不受 init 脚本影响，需按 deploy/DEPLOY.md §4 手工迁移后重启 backend。
ECHOLINT_APP_PASSWORD=CHANGE_ME_STRONG_APP_DB_PASSWORD

# ---- 必填：引导管理员与 AI 密钥加密 ---------------------------------------
# 首次启动且用户表为空时创建的管理员（生产必须改默认密码）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# AI 供应商密钥加密主密钥；变更后旧密文无法解密需重新录入供应商密钥（只写一次，妥善保存）
APP_SECRET_KEY=CHANGE_ME_RANDOM_32_BYTES_BASE64_OR_LONG_STRING

# ---- AI / RAG（按需）-------------------------------------------------------
# API Key 只存数据库：推荐部署后在「系统设置」页录入（AES-GCM 加密落库、界面只回掩码）。
# 下面两行仅作为首次启动的引导值，可留空；填了也只在 DB 缺密钥时导入一次。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_SCREEN_PROVIDER=deepseek
APP_RAG_ENABLED=false

# ---- 语音转写（部署后在「系统设置 → 语音转写」二选一）----------------------
# ① 阿里云百炼录音文件识别（推荐）：在设置页录入 Key 即可，无需宿主服务；
# ② 本机 whisper.cpp（可选兜底）：容器经 compose 的 extra_hosts 解析 host.docker.internal，
#    宿主侧用 WHISPER_HOST=0.0.0.0 启动并用防火墙只放行 Docker 网桥网段（whisper.cpp 无鉴权）。
# WHISPER_BASE_URL=http://host.docker.internal:9900
# WHISPER_API_KEY=local         # 仅首次启动引导值；whisper.cpp 不校验密钥，默认 local 会自动落库
# 百炼录音识别（可选默认值，实际配置以设置页保存的为准）
# DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
# ASR_TIMEOUT_SECONDS=600

# ---- 其余可选开关（完整说明见仓库根 .env.example，按需取消注释）----------
# APP_NOTIFY_ENABLED=true
# APP_NOTIFY_WEBHOOK_URL=https://example.com/hook
# APP_NOTIFY_WEBHOOK_SECRET=
# APP_SAMPLE_DFA_MISS_RATE=0
# APP_STEREO_ENABLED=true
# APP_REVIEW_REQUIRED_APPROVALS=1
# APP_TENANT_ENABLED=false
# APP_SSO_ENABLED=false
# APP_ASR_STREAMING_ENABLED=false
# APP_DIARIZATION_ENABLED=false
# APP_SCREEN_DAILY_TOKEN_LIMIT=0
# APP_SCREEN_REQUESTS_PER_MINUTE=0
