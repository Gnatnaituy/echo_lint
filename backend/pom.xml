<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.echolint</groupId>
    <artifactId>echolint-backend</artifactId>
    <version>1.0.0</version>
    <name>echolint-backend</name>
    <description>EchoLint 后端：录音上传 → Whisper 转写 → DFA 初筛 → AI 语义复筛 → 人工复检 → 语料回馈</description>

    <properties>
        <java.version>17</java.version>

        <!-- 第三方依赖版本：集中管理，便于按期升级（审计 P2-34）。 -->
        <!-- Spring Boot 3.5.x 是当前仍有 OSS 支持的 3.x 版本线（4.x 为大版本迁移，暂不跟进）。 -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- PDFBox 保持 2.x 线（3.x 有 API 破坏性变更，迁移需改源码）。 -->
        <pdfbox.version>2.0.37</pdfbox.version>
        <poi.version>5.5.1</poi.version>

        <!--
          Spotless 格式守卫（审计 P2-29）：ratchetFrom 表示「只校验相对该 git ref 变更过的文件」，
          默认 origin/main，避免首次接入时一次性重排全量 Java 源码。
          没有 origin/main 的浅克隆/离线环境可覆盖，例如：
            mvn spotless:check -Dspotless.ratchetFrom=HEAD~1
        -->
        <spotless.ratchetFrom>origin/main</spotless.ratchetFrom>
        <spotless.version>3.11.0</spotless.version>
        <google-java-format.version>1.34.0</google-java-format.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 可观测性：/actuator/prometheus 暴露 JVM/HTTP/连接池指标 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- OpenAPI 文档 + Swagger UI（/v3/api-docs、/swagger-ui/index.html） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- 数据库版本化迁移：基线 V1 仅登记版本，后续迁移从 V2 开始 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动（pgvector 无需额外 Java 依赖：向量以文本形式映射，配合 NUMERIC/CAST 使用） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文档导入（RAG Phase D）：PDF / DOCX 文本抽取 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              代码格式守卫（审计 P2-29）：`mvn spotless:check` 校验 Java 格式；
              ratchetFrom 使检查范围收敛到「相对 origin/main 变更过的文件」，
              因此存量 2.8 万行 Java 不会被一次性重排。
              维护者提交前可用 `mvn spotless:apply` 只格式化自己改动的文件。
              注意：默认不绑定到 test 阶段，避免干扰日常 `mvn test`；verify 阶段会执行 check。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <ratchetFrom>${spotless.ratchetFrom}</ratchetFrom>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <!-- AOSP = 4 空格缩进，贴近仓库既有风格，减少格式化 diff -->
                            <style>AOSP</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
