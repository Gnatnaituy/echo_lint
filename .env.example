# EchoLint 环境变量（复制为 .env 后填写，docker compose 会自动读取并注入 backend 容器）
# - 本文件中的变量通过 docker-compose.yml 的 env_file 整体注入 backend（需要 Compose >= 2.24；
#   compose 的显式 environment 优先级更高，会覆盖这里的同名项）。
# - 首次使用：cp .env.example .env，再按需取消注释；生产至少修改 POSTGRES_PASSWORD /
#   APP_ADMIN_PASSWORD / APP_SECRET_KEY。

# ---- 数据库（PostgreSQL 17 + pgvector）----
# 数据库口令：postgres 容器与 backend 共用（compose 的 POSTGRES_PASSWORD 与
# SPRING_DATASOURCE_PASSWORD 都由它插值）。默认值仅用于本地开发，生产必须改成强口令。
# 注意：口令只在「全新 pg-data 数据卷」首次初始化时生效；已有数据卷不会随这里变化，
#       轮换时先执行：docker exec -it echolint-postgres psql -U audit -d echolint \
#         -c "ALTER USER audit PASSWORD '新口令';"  然后再更新本文件的 POSTGRES_PASSWORD。
POSTGRES_PASSWORD=audit123

# docker compose 内的后端由 docker-compose.yml 注入 jdbc:postgresql://postgres:5432/echolint，无需在此填写。
# 下面的值供「本机直接运行后端」使用；application.yml 的默认值即 localhost:5432。
# 若后端跑在宿主机、数据库在 compose 容器里（宿主端口 5433），改 URL 为 localhost:5433：
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/echolint
# SPRING_DATASOURCE_USERNAME=audit
# SPRING_DATASOURCE_PASSWORD=audit123

# ---- 阿里云百炼（RAG embedding，必需）----
# 控制台创建 API Key：https://bailian.console.aliyun.com/
# embedding 模型 qwen3.7-text-embedding 默认 1024 维（也可用 text-embedding-v4 / v3）
# 新账号通常有免费额度（以控制台为准）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 端点以控制台「业务空间」为准；公共兼容端点默认如下（compose 已透传）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：把百炼当 chat 模型时的默认模型（仅切换复筛供应商时需要）
# DASHSCOPE_CHAT_MODEL=qwen-plus

# ---- DeepSeek（可选：AI 语义复筛 + 敏感词挖掘）----
# 填好后到「系统设置」页把复筛模型切到 DeepSeek，立即生效且重启后保持
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 端点可指向代理（compose 已透传）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SCREEN_MODEL=deepseek-flash

# 可选：首次启动的默认复筛供应商（未在界面切换过时生效）：deepseek | aliyun
# APP_SCREEN_PROVIDER=deepseek

# ---- 语音转写 ASR（双 provider：本机 whisper.cpp / 阿里云百炼，运行时切换）----
# 默认：本地 whisper.cpp。配置了 DASHSCOPE_API_KEY 不会自动切到百炼（该 Key 与 RAG embedding 共用）；
# 只有「系统设置 → 语音转写」页显式选择 provider 并保存才会切换，保存后立即生效、重启保持。
# 非密钥项（base-url/model/language-hints/timeout）本段可作默认值；数据库已保存的值优先。
#
# 【API Key 只存数据库】所有 ASR 密钥在设置页录入，AES-GCM 加密落库，接口只回掩码。
# 下面的 DASHSCOPE_API_KEY 仅作为「首次启动的一次性引导值」（DB 缺密钥时加密落库一次，之后不再读取）；
# 推荐不配置，直接部署后在设置页录入。WHISPER_API_KEY 同理（本地方案不校验密钥，缺省用 local）。
#
# 百炼录音文件识别（阿里云 DashScope 异步任务）：
# - base-url 是 DashScope API 根，不是 compatible-mode 地址；也可填业务空间域名
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com
# 识别模型：qwen-audio-3.1-asr-flash-filetrans（默认，支持方言/热词/说话人分离）、
#           qwen-audio-3.0-asr-flash-filetrans；也可在设置页手填其它模型名
# DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
# 逗号分隔语言提示，第一项作为转写结果的 language 字段
# DASHSCOPE_ASR_LANGUAGE_HINTS=zh
#
# 单次转写总预算：本地 block 超时 / 云端「提交 + 轮询 + 下载」总预算，范围 30~1800 秒
# ASR_TIMEOUT_SECONDS=600
#
# 本地方案（whisper.cpp）的 WHISPER_* 变量见下方「本机 whisper.cpp 转写」一节；
# 旧 whisper.request-timeout-seconds 已废弃，统一由 ASR_TIMEOUT_SECONDS / 设置页超时接管。

# ---- 本机 whisper.cpp 转写（本地 ASR provider：录音不出本机、无时长费用、无并发限制）----
# 1) brew install whisper.cpp ffmpeg（Linux 用发行版包管理器安装 whisper.cpp / ffmpeg）
# 2) 下载模型并 tools/whisper-server.sh --daemon
# 3) 取消下面两行注释后 docker compose up -d
# WHISPER_BASE_URL=http://host.docker.internal:9900
# WHISPER_API_KEY=local          # 仅首次启动引导值；whisper.cpp 不校验密钥，默认 local 会自动落库
# 后端发起请求时携带的 model 名（whisper.cpp 忽略该字段，仅要求非空；默认 whisper-1 即可，
# 通常无需修改。注意：tools/whisper-server.sh 也用 WHISPER_MODEL 指定模型文件路径，
# 那是在宿主 shell 里运行脚本时设置的环境变量，不要把它和本项混用）
# WHISPER_MODEL=whisper-1
# whisper 转写端点路径（whisper.cpp 默认为 /v1/audio/transcriptions，一般无需修改）
# WHISPER_AUDIO_PATH=/v1/audio/transcriptions
#
# Linux 生产机（Docker Engine）：compose 已给 backend 配置 extra_hosts: host-gateway，
# 但 whisper-server 默认只监听 127.0.0.1，容器仍然访问不到，需显式绑定所有网卡：
#   WHISPER_HOST=0.0.0.0 tools/whisper-server.sh --daemon
# whisper.cpp 无鉴权，务必用防火墙只放行 Docker 网桥网段（默认 172.17.0.0/16）：
#   sudo ufw allow from 172.16.0.0/12 to any port 9900 proto tcp
# 排障（backend 镜像无 curl，先用 bash 探 TCP；HTTP 层在宿主机验证）：
#   docker exec echolint-backend bash -c 'echo > /dev/tcp/host.docker.internal/9900 && echo REACHABLE'
#   curl -s -o /dev/null -w '%{http_code}\n' -X POST http://127.0.0.1:9900/v1/audio/transcriptions \
#     -F file=@sample.wav -F model=whisper-1

# 上传大小上限（字节，后端校验；nginx 的 client_max_body_size 为 220m，不要设得更大；
# 容器内上传目录由 compose 固定为 /app/data/uploads，不需要在 .env 设置）
# APP_MAX_SIZE_BYTES=209715200

# 可选：双声道（双轨）处理开关与说话人名称
# APP_STEREO_ENABLED=true
# APP_STEREO_LEFT_SPEAKER=坐席
# APP_STEREO_RIGHT_SPEAKER=客户

# ---- 账号与复核（生产必改）----
# 首次启动且用户表为空时创建的管理员；默认 admin / admin12345
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=请改成强密码（至少 8 位）
# 一条录音需要几个复核人通过才落最终结论：1=单人复核，2=双人复核
# APP_REVIEW_REQUIRED_APPROVALS=1

# ---- 合规抽样（Batch 2b-2）----
# DFA 未命中的录音按比例送 AI 复筛（0=关闭，1=全部）；AI 不可用/低置信度转人工
# APP_SAMPLE_DFA_MISS_RATE=0.1

# ---- Webhook 通知告警（可选）----
# 复核确认违规 / 流水线失败 / 每日待复核积压 / 测试通知
# APP_NOTIFY_ENABLED=true
# APP_NOTIFY_WEBHOOK_URL=https://example.com/hook
# APP_NOTIFY_WEBHOOK_SECRET=请在接收端校验 X-EchoLint-Signature
# APP_NOTIFY_TIMEOUT_SECONDS=5
# APP_NOTIFY_BACKLOG_THRESHOLD=50

# ---- 集成适配器（Batch 5，默认全部关闭；契约与接入步骤见 docs/integrations.md）----
# 多租户：本轮只解析租户上下文，不做数据隔离；HEADER 模式下 /api/** 必须带租户头
# APP_TENANT_ENABLED=false
# APP_TENANT_MODE=SINGLE          # SINGLE | HEADER
# APP_TENANT_HEADER=X-Tenant-Id
# SSO / LDAP：只暴露状态与登录跳转，不引入身份源客户端；密钥仅从环境变量注入
# APP_SSO_ENABLED=false
# APP_SSO_PROVIDER=OIDC           # OIDC | LDAP
# APP_SSO_ISSUER=
# APP_SSO_CLIENT_ID=
# APP_SSO_CLIENT_SECRET=
# APP_SSO_ROLE_MAPPING_JSON=      # IdP 组 → 本地角色（ADMIN/REVIEWER/VIEWER）的 JSON
# 实时（流式）转写：默认关闭，不改变现有批量转写流程
# APP_ASR_STREAMING_ENABLED=false
# APP_ASR_STREAMING_PROVIDER=
# APP_ASR_STREAMING_ENDPOINT=
# APP_ASR_STREAMING_API_KEY=
# 单声道说话人分离：默认关闭；双声道仍走左右声道方案
# APP_DIARIZATION_ENABLED=false
# APP_DIARIZATION_PROVIDER=
# APP_DIARIZATION_ENDPOINT=
# APP_DIARIZATION_API_KEY=

# ---- AI 全文分块与严格解析 ----
# APP_SCREEN_CHUNK_CHARS=12000
# APP_SCREEN_MAX_CHUNKS=6
# APP_SCREEN_MIN_CONFIDENCE=0.6

# ---- AI 供应商密钥加密（生产必须配置）----
# Base64 32 字节或任意字符串（内部 SHA-256 派生）；变更后旧密文无法解密，需重新录入供应商密钥
# APP_SECRET_KEY=请改成随机长字符串

# ---- AI 配额（0=不限）----
# 每日 token 上限（成功调用的 input+output 合计）
# APP_SCREEN_DAILY_TOKEN_LIMIT=0
# 每分钟请求数（进程内按供应商计数）
# APP_SCREEN_REQUESTS_PER_MINUTE=0

# ---- 语义复筛 A/B 分流（可选，只读配置，仅语义复筛参与）----
# APP_SCREEN_AB_ENABLED=true
# APP_SCREEN_AB_PERCENT=10
# APP_SCREEN_AB_PROVIDER=deepseek
# APP_SCREEN_AB_MODEL=deepseek-v4-pro

# ---- 数据保留/清理（可选，默认关闭；审计 P2-30）----
# 开启后每天按保留天数分批删除超期行（每批 500 条，避免长事务）；原始录音 uploads 不自动删除。
# 注意：开启前请确认备份/合规留存要求；审计日志保留期建议按合规要求配置（默认 365 天）。
# APP_RETENTION_ENABLED=false
# 每日执行时间（Spring cron 6 段：秒 分 时 日 月 周；默认 03:30）
# APP_RETENTION_CRON=0 30 3 * * *
# AI 调用留痕保留天数（含请求/回复全文，通常是容量大头）
# APP_RETENTION_AI_INVOCATIONS_DAYS=180
# 审计日志保留天数
# APP_RETENTION_AUDIT_LOGS_DAYS=365
# 流水线日志保留天数
# APP_RETENTION_PIPELINE_LOGS_DAYS=90

# ---- RAG 检索增强（Batch 6，默认关闭；关闭时不发起任何 embedding 调用，行为与旧版一致）----
# docker-compose 已透传全部 APP_RAG_* 变量（文档目录在容器内固定为 /app/data/knowledge-docs）。
# 注意：enabled / top-k / min-score / max-context-chars / corpus-examples 在「系统设置」页保存后会写入
# app_settings 并优先生效（source=settings）；这里的值只作为首次启动/未在界面保存过的默认值。
# 总开关：知识库语义检索 + 复筛引用留痕 + 语料语义 few-shot；开启前需先配置可用的 embedding 供应商
# APP_RAG_ENABLED=false

# 检索参数
# 召回条数（1~20）
# APP_RAG_TOP_K=4
# 余弦相似度下限（0~1），低于该值丢弃
# APP_RAG_MIN_SCORE=0.25
# 注入 prompt 的知识片段总字符上限（200~20000）
# APP_RAG_MAX_CONTEXT_CHARS=2400
# 语义 few-shot 条数（0~20）；0 = 回退旧的「最新 N 条」逻辑
# APP_RAG_CORPUS_EXAMPLES=5

# embedding（复用 ai_providers 中已配置 base-url/api-key 的供应商；默认阿里云百炼）
# APP_RAG_EMBEDDING_PROVIDER=aliyun
# APP_RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
# base-url 已含 /compatible-mode/v1，因此路径是 /embeddings
# APP_RAG_EMBEDDING_PATH=/embeddings
# 维度必须与 V3 迁移里 HNSW 索引的维度一致（默认 1024）；换模型/维度需重建索引
# APP_RAG_EMBEDDING_DIMENSIONS=1024
# 是否在请求体显式发送 dimensions（阿里云支持）
# APP_RAG_EMBEDDING_SEND_DIMENSIONS=true
# 单次请求超时（1~120 秒）
# APP_RAG_EMBEDDING_TIMEOUT=30
# 单批 embedding 条数（1~64；阿里云 v3/v4 单请求最多 10 条，默认 8 兼容所有模型）
# APP_RAG_EMBEDDING_BATCH_SIZE=8
# embedding 输入单价（USD / 1K tokens，可选）：留空回退供应商 inputPricePer1k；
# 同一供应商同时承载 chat 与 embedding 时建议显式配置（成本看板口径，审计 P2-10）
# APP_RAG_EMBEDDING_INPUT_PRICE_PER_1K=

# 知识库分块
# 单块字符数（100~4000）
# APP_RAG_CHUNK_CHARS=600
# 相邻块重叠字符数（0 ~ 单块字符数/2）
# APP_RAG_CHUNK_OVERLAP=80

# 语料 embedding 前的截断长度（200~20000）
# APP_RAG_CORPUS_MAX_CHARS=6000

# 异步索引
# 索引线程数（1~8）
# APP_RAG_INDEX_POOL=2
# 启动时是否回填未索引的知识库条目与语料
# APP_RAG_STARTUP_BACKFILL=true

# 文档导入（Phase D）：PDF/DOCX/TXT/MD 解析为知识库条目
# 文档目录（相对后端工作目录；compose 内固定 /app/data/knowledge-docs，挂 knowledge-docs 卷）
# APP_RAG_DOCUMENTS_DIR=data/knowledge-docs
# 单文档大小上限（字节，默认 20MB）
# APP_RAG_DOCUMENTS_MAX_BYTES=20971520
# 允许的扩展名（逗号分隔）
# APP_RAG_DOCUMENTS_EXTENSIONS=pdf,docx,txt,md
