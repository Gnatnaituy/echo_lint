# EchoLint 环境变量（复制为 .env 后填写，docker compose 会自动读取）

# OpenAI API 密钥：用于 Whisper 转写、AI 语义复筛与敏感词挖掘
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：指向代理 / 网关
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_SCREEN_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1

# 可选：双声道（双轨）处理开关与说话人名称
# APP_STEREO_ENABLED=true
# APP_STEREO_LEFT_SPEAKER=坐席
# APP_STEREO_RIGHT_SPEAKER=客户
