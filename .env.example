# EchoLint 环境变量（复制为 .env 后填写，docker compose 会自动读取）

# ---- OpenAI ----
# 必需：Whisper 语音转写固定走 OpenAI（chat 类供应商不提供转写能力）
# 若同时把 OpenAI 用作复筛模型，这一个 key 就够了
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：指向代理 / 网关
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_SCREEN_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1

# ---- DeepSeek（可选：AI 语义复筛 + 敏感词挖掘）----
# 填好后到「系统设置」页把复筛模型切到 DeepSeek，立即生效且重启后保持
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SCREEN_MODEL=deepseek-flash

# 可选：首次启动的默认复筛供应商（未在界面切换过时生效）：openai | deepseek
# APP_SCREEN_PROVIDER=openai

# 可选：双声道（双轨）处理开关与说话人名称
# APP_STEREO_ENABLED=true
# APP_STEREO_LEFT_SPEAKER=坐席
# APP_STEREO_RIGHT_SPEAKER=客户
