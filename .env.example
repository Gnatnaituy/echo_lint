# EchoLint 环境变量（复制为 .env 后填写，docker compose 会自动读取）

# ---- 数据库（PostgreSQL 17 + pgvector）----
# docker compose 内的后端由 docker-compose.yml 注入 jdbc:postgresql://postgres:5432/echolint，无需在此填写。
# 下面的值供「本机直接运行后端」使用；application.yml 的默认值即 localhost:5432。
# 若后端跑在宿主机、数据库在 compose 容器里（宿主端口 5433），改 URL 为 localhost:5433：
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/echolint
# SPRING_DATASOURCE_USERNAME=audit
# SPRING_DATASOURCE_PASSWORD=audit123

# ---- 阿里云百炼（RAG embedding，必需）----
# 控制台创建 API Key：https://bailian.console.aliyun.com/
# embedding 模型 qwen3.7-text-embedding 默认 1024 维（也可用 text-embedding-v4 / v3）
# 新账号通常有免费额度（以控制台为准）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 端点以控制台「业务空间」为准；公共兼容端点默认如下（compose 已透传）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：把百炼当 chat 模型时的默认模型（仅切换复筛供应商时需要）
# DASHSCOPE_CHAT_MODEL=qwen-plus

# ---- DeepSeek（可选：AI 语义复筛 + 敏感词挖掘）----
# 填好后到「系统设置」页把复筛模型切到 DeepSeek，立即生效且重启后保持
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 端点可指向代理（compose 已透传）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SCREEN_MODEL=deepseek-flash

# 可选：首次启动的默认复筛供应商（未在界面切换过时生效）：deepseek | aliyun
# APP_SCREEN_PROVIDER=deepseek

# ---- 本机 whisper.cpp 转写（必需：录音不出本机、无时长费用、无并发限制）----
# 1) brew install whisper.cpp ffmpeg
# 2) 下载模型并 tools/whisper-server.sh --daemon
# 3) 取消下面两行注释后 docker compose up -d
# WHISPER_BASE_URL=http://host.docker.internal:9900
# WHISPER_API_KEY=local          # whisper.cpp 不校验密钥，但后端要求非空

# 可选：双声道（双轨）处理开关与说话人名称
# APP_STEREO_ENABLED=true
# APP_STEREO_LEFT_SPEAKER=坐席
# APP_STEREO_RIGHT_SPEAKER=客户

# ---- 账号与复核（生产必改）----
# 首次启动且用户表为空时创建的管理员；默认 admin / admin12345
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=请改成强密码（至少 8 位）
# 一条录音需要几个复核人通过才落最终结论：1=单人复核，2=双人复核
# APP_REVIEW_REQUIRED_APPROVALS=1

# ---- 合规抽样（Batch 2b-2）----
# DFA 未命中的录音按比例送 AI 复筛（0=关闭，1=全部）；AI 不可用/低置信度转人工
# APP_SAMPLE_DFA_MISS_RATE=0.1

# ---- Webhook 通知告警（可选）----
# 复核确认违规 / 流水线失败 / 每日待复核积压 / 测试通知
# APP_NOTIFY_ENABLED=true
# APP_NOTIFY_WEBHOOK_URL=https://example.com/hook
# APP_NOTIFY_WEBHOOK_SECRET=请在接收端校验 X-EchoLint-Signature
# APP_NOTIFY_TIMEOUT_SECONDS=5
# APP_NOTIFY_BACKLOG_THRESHOLD=50

# ---- AI 全文分块与严格解析 ----
# APP_SCREEN_CHUNK_CHARS=12000
# APP_SCREEN_MAX_CHUNKS=6
# APP_SCREEN_MIN_CONFIDENCE=0.6

# ---- AI 供应商密钥加密（生产必须配置）----
# Base64 32 字节或任意字符串（内部 SHA-256 派生）；变更后旧密文无法解密，需重新录入供应商密钥
# APP_SECRET_KEY=请改成随机长字符串

# ---- AI 配额（0=不限）----
# 每日 token 上限（成功调用的 input+output 合计）
# APP_SCREEN_DAILY_TOKEN_LIMIT=0
# 每分钟请求数（进程内按供应商计数）
# APP_SCREEN_REQUESTS_PER_MINUTE=0

# ---- 语义复筛 A/B 分流（可选，只读配置，仅语义复筛参与）----
# APP_SCREEN_AB_ENABLED=true
# APP_SCREEN_AB_PERCENT=10
# APP_SCREEN_AB_PROVIDER=deepseek
# APP_SCREEN_AB_MODEL=deepseek-v4-pro

# ---- RAG 检索增强（Batch 6，默认关闭；关闭时不发起任何 embedding 调用，行为与旧版一致）----
# docker-compose 已透传全部 APP_RAG_* 变量（文档目录在容器内固定为 /app/data/knowledge-docs）。
# 注意：enabled / top-k / min-score / max-context-chars / corpus-examples 在「系统设置」页保存后会写入
# app_settings 并优先生效（source=settings）；这里的值只作为首次启动/未在界面保存过的默认值。
# 总开关：知识库语义检索 + 复筛引用留痕 + 语料语义 few-shot；开启前需先配置可用的 embedding 供应商
# APP_RAG_ENABLED=false

# 检索参数
# 召回条数（1~20）
# APP_RAG_TOP_K=4
# 余弦相似度下限（0~1），低于该值丢弃
# APP_RAG_MIN_SCORE=0.25
# 注入 prompt 的知识片段总字符上限（200~20000）
# APP_RAG_MAX_CONTEXT_CHARS=2400
# 语义 few-shot 条数（0~20）；0 = 回退旧的「最新 N 条」逻辑
# APP_RAG_CORPUS_EXAMPLES=5

# embedding（复用 ai_providers 中已配置 base-url/api-key 的供应商；默认阿里云百炼）
# APP_RAG_EMBEDDING_PROVIDER=aliyun
# APP_RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
# base-url 已含 /compatible-mode/v1，因此路径是 /embeddings
# APP_RAG_EMBEDDING_PATH=/embeddings
# 维度必须与 V3 迁移里 HNSW 索引的维度一致（默认 1024）；换模型/维度需重建索引
# APP_RAG_EMBEDDING_DIMENSIONS=1024
# 是否在请求体显式发送 dimensions（阿里云支持）
# APP_RAG_EMBEDDING_SEND_DIMENSIONS=true
# 单次请求超时（1~120 秒）
# APP_RAG_EMBEDDING_TIMEOUT=30
# 单批 embedding 条数（1~64；阿里云 v3/v4 单请求最多 10 条，默认 8 兼容所有模型）
# APP_RAG_EMBEDDING_BATCH_SIZE=8

# 知识库分块
# 单块字符数（100~4000）
# APP_RAG_CHUNK_CHARS=600
# 相邻块重叠字符数（0 ~ 单块字符数/2）
# APP_RAG_CHUNK_OVERLAP=80

# 语料 embedding 前的截断长度（200~20000）
# APP_RAG_CORPUS_MAX_CHARS=6000

# 异步索引
# 索引线程数（1~8）
# APP_RAG_INDEX_POOL=2
# 启动时是否回填未索引的知识库条目与语料
# APP_RAG_STARTUP_BACKFILL=true

# 文档导入（Phase D）：PDF/DOCX/TXT/MD 解析为知识库条目
# 文档目录（相对后端工作目录；compose 内固定 /app/data/knowledge-docs，挂 knowledge-docs 卷）
# APP_RAG_DOCUMENTS_DIR=data/knowledge-docs
# 单文档大小上限（字节，默认 20MB）
# APP_RAG_DOCUMENTS_MAX_BYTES=20971520
# 允许的扩展名（逗号分隔）
# APP_RAG_DOCUMENTS_EXTENSIONS=pdf,docx,txt,md
